#!/data/user/0/com.agy/files/usr/bin/bash
# agy-fix-paths [PATH...] -- rewrite hardcoded Android app prefixes & desktop shebangs.
set -uo pipefail

if [ -z "${PREFIX:-}" ]; then
    _agy_script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    PREFIX="$(cd -- "$_agy_script_dir/.." 2>/dev/null && pwd)"
    unset _agy_script_dir
fi
HOME_DIR="${HOME:-$(dirname "$PREFIX")}"
PATTERN='/data/(data|user/[0-9]+)/[^/]*/files/usr'

if [ "$#" -gt 0 ]; then
    targets=("$@")
else
    targets=("$PREFIX")
    if [ -d "$HOME_DIR/.gemini/config/plugins" ]; then
        targets+=("$HOME_DIR/.gemini/config/plugins")
    fi
fi

esc="$(printf '%s' "$PREFIX" | sed 's/[\\&@]/\\&/g')"
count=0

# 1. Fix app-private prefixes
while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    [ -L "$f" ] && continue
    tmp="$f.agyfix.$$"
    if sed -E "s@$PATTERN@$esc@g" "$f" > "$tmp" 2>/dev/null; then
        if cmp -s "$f" "$tmp"; then
            rm -f "$tmp"
        else
            mode="$(stat -c '%a' "$f" 2>/dev/null)" || mode=""
            [ -n "$mode" ] && chmod "$mode" "$tmp" 2>/dev/null
            mv -f "$tmp" "$f"
            count=$((count + 1))
        fi
    else
        rm -f "$tmp"
    fi
done < <(grep -rIlZ -E -e "$PATTERN" -- "${targets[@]}" 2>/dev/null)

# 2. Fix /usr/bin/env shebangs to $PREFIX/bin/
while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    [ -L "$f" ] && continue
    tmp="$f.agyfix.$$"
    if sed -E "1s@^#! */usr/bin/env[[:space:]]+(-S[[:space:]]+)?([^[:space:]]+)@#!$esc/bin/\\2@" "$f" > "$tmp" 2>/dev/null; then
        if cmp -s "$f" "$tmp"; then
            rm -f "$tmp"
        else
            mode="$(stat -c '%a' "$f" 2>/dev/null)" || mode=""
            [ -n "$mode" ] && chmod "$mode" "$tmp" 2>/dev/null
            mv -f "$tmp" "$f"
            count=$((count + 1))
        fi
    else
        rm -f "$tmp"
    fi
done < <(grep -rIlZ -E -m 1 -e '^#! */usr/bin/env' -- "${targets[@]}" 2>/dev/null)

# 2b. Fix #!/bin/sh shebangs to #!/system/bin/sh (Android Bionic lacks /bin/sh)
while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    [ -L "$f" ] && continue
    tmp="$f.agyfix.$$"
    if sed -E "1s@^#! */bin/sh([[:space:]]|\$)@#!/system/bin/sh\\1@" "$f" > "$tmp" 2>/dev/null; then
        if cmp -s "$f" "$tmp"; then
            rm -f "$tmp"
        else
            mode="$(stat -c '%a' "$f" 2>/dev/null)" || mode=""
            [ -n "$mode" ] && chmod "$mode" "$tmp" 2>/dev/null
            mv -f "$tmp" "$f"
            count=$((count + 1))
        fi
    else
        rm -f "$tmp"
    fi
done < <(grep -rIlZ -E -m 1 -e '^#! */bin/sh([[:space:]]|$)' -- "${targets[@]}" 2>/dev/null)

# 3. Retarget symlinks pointing to hardcoded app-private prefixes
while IFS= read -r -d '' f; do
    [ -n "$f" ] || continue
    link_dst="$(readlink "$f" 2>/dev/null)" || continue
    new_dst="$(printf '%s' "$link_dst" | sed -E "s@$PATTERN@$esc@g")"
    if [ -n "$new_dst" ] && [ "$new_dst" != "$link_dst" ]; then
        if ln -snf "$new_dst" "$f" 2>/dev/null; then
            count=$((count + 1))
        fi
    fi
done < <(find "${targets[@]}" -type l -print0 2>/dev/null)

# 4. Auto-symlink OpenJDK binaries ($PREFIX/lib/jvm/java-*-openjdk/bin/*) into $PREFIX/bin
if [ -d "$PREFIX/lib/jvm" ] && [ -d "$PREFIX/bin" ]; then
    for jbin in "$PREFIX"/lib/jvm/java-*-openjdk/bin/*; do
        [ -f "$jbin" ] && [ -x "$jbin" ] || continue
        jbname="$(basename "$jbin")"
        if [ ! -e "$PREFIX/bin/$jbname" ] && [ ! -L "$PREFIX/bin/$jbname" ]; then
            rel_jbin="${jbin#$PREFIX/}"
            if ln -snf "../$rel_jbin" "$PREFIX/bin/$jbname" 2>/dev/null; then
                count=$((count + 1))
            fi
        fi
    done
fi

printf 'agy-fix-paths: rewrote %d file(s)/link(s) -> %s\n' "$count" "$PREFIX"
