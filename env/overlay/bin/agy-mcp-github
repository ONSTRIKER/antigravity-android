#!/data/user/0/com.agy/files/usr/bin/python3
"""
agy-mcp-github - Zero-secret native GitHub MCP server powered by the authenticated
`gh` CLI on Android (zero tokens stored in mcp_config.json).

Protocol: JSON-RPC 2.0 over newline-delimited stdin/stdout (MCP 2024-11-05+).
"""

import json
import os
import subprocess
import sys

SERVER_NAME = "github"
SERVER_VERSION = "1.0.0"
SUPPORTED_PROTOCOL_VERSIONS = ("2025-06-18", "2025-03-26", "2024-11-05")
DEFAULT_PROTOCOL_VERSION = "2024-11-05"
MAX_OUTPUT_BYTES = 64 * 1024


def _get_prefix():
    p = os.environ.get("PREFIX", "").strip()
    return p if p else os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _get_home():
    h = os.environ.get("HOME", "").strip()
    return h if h else os.path.dirname(_get_prefix())


def _gh_bin():
    cand = os.path.join(_get_prefix(), "bin", "gh")
    return cand if os.path.isfile(cand) else "gh"


def _truncate(text, limit=MAX_OUTPUT_BYTES):
    raw = (text or "").encode("utf-8", errors="replace")
    if len(raw) <= limit:
        return text or ""
    return raw[:limit].decode("utf-8", errors="ignore") + f"\n...[truncated {len(raw) - limit} bytes]"


def _run_gh(cli_args, timeout_sec=30):
    env = os.environ.copy()
    env["HOME"] = _get_home()
    env["PREFIX"] = _get_prefix()
    try:
        proc = subprocess.run(
            [_gh_bin()] + cli_args,
            capture_output=True,
            text=True,
            timeout=timeout_sec,
            env=env,
        )
        out = (proc.stdout or "").strip()
        err = (proc.stderr or "").strip()
        if proc.returncode != 0:
            return {"ok": False, "exit_code": proc.returncode, "error": err or out or f"gh exited {proc.returncode}"}
        if out:
            try:
                return {"ok": True, "data": json.loads(out)}
            except json.JSONDecodeError:
                return {"ok": True, "output": _truncate(out)}
        return {"ok": True, "output": _truncate(err)}
    except FileNotFoundError:
        return {"ok": False, "error": "gh CLI is not installed (run `pkg install gh`)."}
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"gh timed out after {timeout_sec}s"}
    except Exception as e:
        return {"ok": False, "error": str(e)}


TOOLS = [
    {
        "name": "github_auth_status",
        "description": "Check authenticated GitHub account and token scopes via `gh auth status`.",
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
    },
    {
        "name": "github_repos",
        "description": "List, inspect, or create GitHub repositories.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "action": {"type": "string", "enum": ["list", "view", "create"], "description": "Repository operation."},
                "repo": {"type": "string", "description": "owner/repo (or repo name for create)."},
                "limit": {"type": "integer", "minimum": 1, "maximum": 100, "description": "Max repos for list (default 30)."},
                "visibility": {"type": "string", "enum": ["public", "private"], "description": "Visibility for create."},
                "description": {"type": "string", "description": "Description for create."},
            },
            "required": ["action"],
            "additionalProperties": False,
        },
    },
    {
        "name": "github_issues",
        "description": "List, view, create, comment on, or close GitHub issues.",
